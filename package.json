{
  "name": "lumen-live",
  "version": "1.3.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "wrangler dev --local --ip 127.0.0.1 --var LOCAL_DEV:true",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && node desktop/launch.cjs",
    "desktop:package": "npm run build && node desktop/package.cjs",
    "desktop:unpacked": "npm run build && node desktop/package.cjs --dir",
    "desktop:import": "node desktop/import-web.mjs",
    "pretest": "npm run build",
    "test:studio": "npm run build && node scripts/studio-qa.mjs",
    "test:card": "npm run build && node scripts/test-card-qa.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "main": "desktop/main.cjs",
  "description": "Lumen visual control desktop application",
  "author": "Lumen",
  "license": "UNLICENSED"
}
